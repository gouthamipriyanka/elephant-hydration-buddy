<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. System CAs only (user-installed CAs are NOT trusted, which blocks
     most on-device interception). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
